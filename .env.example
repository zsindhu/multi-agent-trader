# Alpaca API Keys (Paper Trading)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Docker / PostgreSQL password — REQUIRED for docker compose (used by docker-compose.yml)
DB_PASSWORD=changeme_in_production

# Database
# Local development (SQLite — default):
DATABASE_URL=sqlite+aiosqlite:///./premium_trader.db
# Docker / Production (PostgreSQL — overridden automatically by docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://premium_trader:your_password@db:5432/premium_trader

# Redis (optional — falls back to in-memory cache)
REDIS_URL=redis://localhost:6379/0

# Trading Mode
TRADING_MODE=paper

# Risk Parameters
MAX_PORTFOLIO_RISK=0.02
MAX_DRAWDOWN=0.10
MAX_POSITION_PCT=0.15

# Scheduling
SCAN_INTERVAL_MINUTES=15

# Notifications (optional)
DISCORD_WEBHOOK_URL=

# Finnhub (free tier — earnings calendar + news headlines)
# Get a free key at https://finnhub.io — takes 30 seconds, no credit card
FINNHUB_API_KEY=

# Together AI — REQUIRED. Powers every LLM agent: Lead Agent + 4 sleeves (GLM-5.2),
# Tier 2b reasoning, Research/Fundamentals analysts, summarizers, conflict judge,
# and the Chat agent (Llama 3.3 / DeepSeek-V3). Get a key at https://api.together.ai
TOGETHER_API_KEY=

# OpenAI — optional. Used only for text-embedding-3-small embeddings
# (pgvector semantic search). Without it, embeddings are disabled.
OPENAI_API_KEY=

# Lead Agent LLM overrides (optional — any OpenAI-compatible endpoint, auth via TOGETHER_API_KEY)
# LLM_MODEL=zai-org/GLM-5.2
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MAX_TOKENS=16384

# Order-fill chase (optional — defaults shown). Orders price at the near touch,
# then re-price up to CHASE_MAX_ATTEMPTS times by CHASE_STEP $/sh, capped at
# CHASE_MAX_CROSS $/sh past the original touch. CHASE_ENABLED=false = single submit.
# CHASE_ENABLED=true
# CHASE_POLL_SECONDS=15
# CHASE_MAX_ATTEMPTS=3
# CHASE_STEP=0.02
# CHASE_MAX_CROSS=0.10

# Legacy — unused since the Lead Agent moved to GLM-5.2 via Together AI (ADR-025).
# ANTHROPIC_API_KEY=
